rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Wins Collection
    match /wins/{winId} {
      function isValidWin(data) {
        let keys = data.keys();
        let requiredKeys = ['text', 'userId', 'createdAt', 'tags', 'starred', 'pinned', 'isHabitMode'];
        
        return keys.hasAll(requiredKeys)
          && keys.size() >= 7 && keys.size() <= 16
          && data.text is string && data.text.size() <= 1000
          && data.userId == request.auth.uid
          && data.createdAt is timestamp
          && data.tags is list && data.tags.size() <= 100
          && data.starred is bool
          && data.pinned is bool
          && data.isHabitMode is bool
          && (keys.hasAny(['imageUrl']) ? (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1040000)) : true)
          && (keys.hasAny(['embedding']) ? (data.embedding == null || data.embedding is list) : true)
          && (keys.hasAny(['reflections']) ? (data.reflections is string && data.reflections.size() <= 5000) : true)
          && (keys.hasAny(['isBeDoHave']) ? data.isBeDoHave is bool : true)
          && (keys.hasAny(['beText']) ? (data.beText == null || data.beText is string) : true)
          && (keys.hasAny(['doText']) ? (data.doText == null || data.doText is string) : true)
          && (keys.hasAny(['haveText']) ? (data.haveText == null || data.haveText is string) : true);
      }

      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(winId) && isValidWin(incoming());
      
      allow update: if isOwner(existing().userId) 
        && isValidWin(incoming())
        && incoming().userId == existing().userId;
        
      allow delete: if isOwner(existing().userId);
    }

    // 2. Tags Collection
    match /tags/{tagId} {
      function isValidTag(data) {
        return data.keys().hasAll(['name', 'userId', 'count'])
          && data.name is string && data.name.size() <= 100
          && data.userId == request.auth.uid;
      }

      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && isValidId(tagId) && isValidTag(incoming());
      
      allow update: if isOwner(existing().userId)
        && isValidTag(incoming());
        
      allow delete: if isOwner(existing().userId);
    }

    // 3. User Profiles
    match /profiles/{userId} {
      function isValidProfile(data) {
        return data.keys().hasAll(['userId', 'streakCount', 'lastWinDate', 'weeklyMomentum'])
          && data.userId == userId
          && data.streakCount is int
          && data.weeklyMomentum is list;
      }

      allow get: if isSignedIn(); // Allow others to see trends/leaderboard but restrict PII if any
      allow list: if isSignedIn(); // For leaderboard
      
      allow create: if isOwner(userId) && isValidProfile(incoming());
      
      allow update: if isOwner(userId)
        && isValidProfile(incoming())
        && incoming().userId == existing().userId
        && (incoming().diff(existing()).affectedKeys().hasAny(['streakCount', 'lastWinDate', 'weeklyMomentum']) || incoming().diff(existing()).affectedKeys().size() == 0);
    }

    // 4. Settings Collection (for Templates)
    match /settings/{userId} {
      function isValidSettings(data) {
        return data.templates is list;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSettings(incoming());
      allow update: if isOwner(userId) && isValidSettings(incoming());
      allow delete: if isOwner(userId);
    }

    match /chat_stars/{starId} {
      function isValidChatStar(data) {
        let keys = data.keys();
        return keys.hasAll(['userId', 'userPrompt', 'aiResponse', 'createdAt'])
          && keys.size() == 4
          && data.userId == request.auth.uid
          && data.userPrompt is string && data.userPrompt.size() <= 5000
          && data.aiResponse is string && data.aiResponse.size() <= 10000
          && data.createdAt is timestamp;
      }
      
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidChatStar(incoming());
      allow delete: if isOwner(resource.data.userId);
      allow update: if false; 
    }

    match /token_logs/{logId} {
      function isValidTokenLog(data) {
        let keys = data.keys();
        return keys.hasAll(['userId', 'functionName', 'inputTokens', 'outputTokens', 'createdAt'])
          && keys.size() == 5
          && (data.userId == 'anonymous' || data.userId == request.auth.uid)
          && data.functionName is string && data.functionName.size() <= 200
          && data.inputTokens is int
          && data.outputTokens is int
          && data.createdAt is timestamp;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidTokenLog(incoming());
      allow update, delete: if false;
    }
  }
}
